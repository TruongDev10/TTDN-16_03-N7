<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View: Danh sách milestone -->
    <record id="view_project_milestone_tree" model="ir.ui.view">
        <field name="name">project.milestone.tree</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <tree string="Milestone" decoration-danger="is_overdue" decoration-success="state=='achieved'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date_deadline"/>
                <field name="date_achieved"/>
                <field name="state" widget="badge" decoration-info="state=='in_progress'" decoration-success="state=='achieved'" decoration-danger="state=='missed'"/>
                <field name="is_overdue" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Form milestone -->
    <record id="view_project_milestone_form" model="ir.ui.view">
        <field name="name">project.milestone.form</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <header>
                    <button name="action_set_in_progress" string="Bắt đầu" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'planned')]}"/>
                    <button name="action_set_achieved" string="Hoàn thành" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'in', ['achieved', 'missed'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,in_progress,achieved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="date_achieved" attrs="{'readonly': [('state', '!=', 'achieved')]}"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Mô tả chi tiết về milestone..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View: Tìm kiếm milestone -->
    <record id="view_project_milestone_search" model="ir.ui.view">
        <field name="name">project.milestone.search</field>
        <field name="model">project.milestone</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Milestone">
                <field name="name" string="Tên"/>
                <field name="project_id" string="Dự án"/>
                <filter string="Quá hạn" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Đã đạt được" name="achieved" domain="[('state', '=', 'achieved')]"/>
                <filter string="Đang thực hiện" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <group expand="0" string="Nhóm">
                    <filter string="Theo Dự án" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Theo Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Mở danh sách milestone -->
    <record id="action_project_milestone" model="ir.actions.act_window">
        <field name="name">Milestone</field>
        <field name="res_model">project.milestone</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
