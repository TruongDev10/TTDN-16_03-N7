<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Project Form View -->
    <record id="view_project_project_form_inherit_ai_analytics" model="ir.ui.view">
        <field name="name">project.project.form.inherit.ai.analytics</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_core.view_project_project_form"/>
        <field name="arch" type="xml">
            <!-- Thêm button box cho đánh giá AI -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_ai_evaluation" string="Đánh giá AI" type="object" class="oe_stat_button" icon="fa-line-chart" context="{'default_project_id': id}">
                    <field name="ai_evaluation_count" widget="statinfo" string="Đánh giá"/>
                </button>
            </xpath>
            
            <!-- Thêm thông tin deadline - insert ONCE after the first group containing date_end -->
            <xpath expr="//group[field[@name='date_end']][1]" position="after">
                <group string="Deadline &amp; Tiến độ">
                    <field name="deadline_days_remaining" readonly="1"/>
                    <field name="deadline_status" widget="badge" decoration-info="deadline_status=='on_time'" decoration-warning="deadline_status=='at_risk'" decoration-danger="deadline_status=='overdue'"/>
                    <field name="latest_ai_score" widget="progressbar" readonly="1" attrs="{'invisible': [('ai_evaluation_count', '=', 0)]}"/>
                </group>
            </xpath>
            
            <!-- Thêm công khai - insert ONCE after the first group containing progress or similar position -->
            <xpath expr="//group[field[@name='progress']][1]" position="after">
                <group string="Công khai">
                    <field name="is_public_progress"/>
                    <field name="is_public_members"/>
                </group>
            </xpath>
            
            <!-- Thêm tab đánh giá AI -->
            <xpath expr="//notebook" position="inside">
                <page string="Đánh giá AI" name="ai_evaluations">
                    <field name="ai_evaluation_ids" nolabel="1" context="{'default_project_id': id}">
                        <tree string="Đánh giá">
                            <field name="evaluation_date"/>
                            <field name="current_progress" widget="progressbar"/>
                            <field name="ai_score" widget="progressbar"/>
                            <field name="score_time" optional="show"/>
                            <field name="score_quality" optional="show"/>
                            <field name="score_risk" widget="badge" decoration-danger="score_risk &gt; 60" decoration-warning="score_risk &gt; 30" decoration-success="score_risk &lt;= 30"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
