<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend HR Employee Form View -->
    <record id="view_employee_form_inherit_project" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.project</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Thêm button box cho dự án và công việc -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_projects" type="object" class="oe_stat_button" icon="fa-briefcase">
                    <field name="project_count" widget="statinfo" string="Dự án"/>
                </button>
                <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                    <field name="task_count" widget="statinfo" string="Công việc"/>
                </button>
            </xpath>
            
            <!-- Thêm field hourly rate -->
            <xpath expr="//field[@name='work_phone']" position="after">
                <group string="Thông tin Dự án">
                    <field name="hourly_rate"/>
                    <field name="currency_id" options="{'no_create': True}"/>
                </group>
            </xpath>
            
            <!-- Thêm tab dự án và công việc -->
            <xpath expr="//notebook" position="inside">
                <page string="Dự án &amp; Công việc" name="projects_tasks">
                    <group>
                        <group string="Dự án">
                            <field name="project_ids" nolabel="1">
                                <tree string="Dự án">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Công việc">
                            <field name="task_ids" nolabel="1">
                                <tree string="Công việc">
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date_deadline"/>
                                    <field name="progress" widget="progressbar"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                    <group string="Workload">
                        <group>
                            <field name="workload_hours" readonly="1"/>
                            <field name="workload_projects" readonly="1"/>
                            <field name="workload_tasks" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
