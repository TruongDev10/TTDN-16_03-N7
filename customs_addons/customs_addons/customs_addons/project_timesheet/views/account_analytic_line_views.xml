<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View: Danh sách timesheet -->
    <record id="view_account_analytic_line_tree_project" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.project</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree string="Chấm công">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="unit_amount" string="Giờ công"/>
                <field name="account_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View: Form timesheet -->
    <record id="view_account_analytic_line_form_project" model="ir.ui.view">
        <field name="name">account.analytic.line.form.project</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <form string="Chấm công">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="name" placeholder="Mô tả công việc..."/>
                            <field name="company_id" invisible="1"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="task_id" domain="[('project_id', '=', project_id)]" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="unit_amount" string="Giờ công"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View: Tìm kiếm timesheet -->
    <record id="view_account_analytic_line_search_project" model="ir.ui.view">
        <field name="name">account.analytic.line.search.project</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Chấm công">
                <field name="name" string="Mô tả"/>
                <field name="project_id" string="Dự án"/>
                <field name="task_id" string="Công việc"/>
                <field name="employee_id" string="Nhân viên"/>
                <field name="user_id" string="Người dùng"/>
                <filter string="Hôm nay" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Tuần này" name="this_week" domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Tháng này" name="this_month" domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Nhóm">
                    <filter string="Theo Dự án" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Theo Công việc" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Theo Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Theo Ngày" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Mở danh sách timesheet -->
    <record id="action_account_analytic_line_project" model="ir.actions.act_window">
        <field name="name">Chấm công</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_account_analytic_line_tree_project"/>
        <field name="search_view_id" ref="view_account_analytic_line_search_project"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo timesheet đầu tiên của bạn!
            </p>
            <p>
                Ghi lại thời gian làm việc của bạn cho các công việc.
            </p>
        </field>
    </record>
</odoo>
