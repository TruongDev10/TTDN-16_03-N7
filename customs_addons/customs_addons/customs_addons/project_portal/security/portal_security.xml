<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record rule: Khách hàng chỉ xem được dự án của mình -->
        <record id="project_project_portal_rule" model="ir.rule">
            <field name="name">Dự án: Portal</field>
            <field name="model_id" ref="project_core.model_project_project"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Record rule: Khách hàng chỉ xem được công việc của dự án mình -->
        <record id="project_task_portal_rule" model="ir.rule">
            <field name="name">Công việc: Portal</field>
            <field name="model_id" ref="project_task.model_project_task"/>
            <field name="domain_force">[('project_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
